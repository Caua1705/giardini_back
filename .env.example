# =========================
# DATABASE
# =========================
DATABASE_URL=postgresql://user:password@host:port/database


# =========================
# SUPABASE STORAGE
# =========================

# Base pública do storage
SUPABASE_STORAGE_BASE_URL=https://your-project-ref.supabase.co/storage/v1/object/public

# Buckets
SUPABASE_MENU_BUCKET=menu
SUPABASE_ENVIRONMENTS_BUCKET=environments


# =========================
# ADMIN AUTH / JWT
# =========================

# Chave secreta usada pelo backend para assinar e validar tokens JWT.

ADMIN_JWT_SECRET=change-this-to-a-long-random-secret-key

# Tempo de expiração do token admin em minutos.
ADMIN_JWT_EXPIRE_MINUTES=1440