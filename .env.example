# =========================
# DATABASE
# =========================
DATABASE_URL=postgresql://user:password@host:port/database


# =========================
# SUPABASE STORAGE
# =========================

# Public storage base URL
SUPABASE_STORAGE_BASE_URL=https://your-project-ref.supabase.co/storage/v1/object/public

# Buckets
SUPABASE_MENU_BUCKET=menu
SUPABASE_ENVIRONMENTS_BUCKET=environments


# =========================
# ADMIN AUTH / JWT
# =========================

# Secret key used by the backend to sign and validate JWT tokens.
ADMIN_JWT_SECRET=change-this-to-a-long-random-secret-key

# Admin token expiration in minutes.
ADMIN_JWT_EXPIRE_MINUTES=1440


# =========================
# INTERNAL API AUTH
# =========================
INTERNAL_API_KEY=sua_chave_super_secreta


# =========================
# N8N WEBHOOKS
# =========================
N8N_RESERVATION_WEBHOOK_URL=
